### 通用配置文件 ###
# 此部分包含编译配置、优化选项和基础软件包
CONFIG_DEVEL=y # 启用开发者模式，显示更多编译选项
CONFIG_TARGET_OPTIONS=y # 启用目标平台选项配置
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53" # ARM架构优化参数
CONFIG_CCACHE=y # 启用编译缓存，加速后续编译
CONFIG_PACKAGE_default-settings=y # 包含默认设置
CONFIG_PACKAGE_default-settings-chn=y # 包含中国区默认设置（时区、源等）
CONFIG_TARGET_PER_DEVICE_ROOTFS=y # 为每个设备生成独立的rootfs
CONFIG_LUCI_LANG_zh_Hant=n # 不包含繁体中文语言支持

# NSS 软件源（IPQ60xx NSS 加速必需）
CONFIG_FEED_nss_packages=y
CONFIG_FEED_sqm_scripts_nss=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

### USB驱动支持 ###
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-xhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-ntfs is not set # 25.12/kernel 6.12 已移除旧 NTFS 驱动，改用 ntfs-3g 或 ext4
CONFIG_PACKAGE_kmod-fs-ntfs3=n # 未来如需内核 NTFS3 再开

### ZRAM内存压缩交换 ###
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 系统工具软件包 ###
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=n
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_tune2fs=n
CONFIG_PACKAGE_fstrim=n
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_hdparm=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=n
CONFIG_PACKAGE_openssh-sftp-server=n
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_chrony=y # NTP 客户端（OAF 时间规则依赖正确时间）
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-unblockneteasemusic=n
CONFIG_PACKAGE_luci-app-ddns-go=n
CONFIG_PACKAGE_luci-app-zerotier=y
#CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-momo=n

### Luci主题和应用 ###
#CONFIG_PACKAGE_luci-theme-aurora=n # 非官方维护，25.12 下若编译失败可忽略或移除
#CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wolplus=n
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-usb-printer=n

### OpenAppFilter（仅适用于 OpenWrt 25.12.x / kernel 6.12，由 Roc-script.sh 拉取）###
#CONFIG_PACKAGE_luci-app-oaf=n
#CONFIG_PACKAGE_appfilter=n
#CONFIG_PACKAGE_kmod-oaf=n

### SQM QoS（NSS 加速版，必须开 luci-app-sqm 才能网页配置）###
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-watchcat=n
# CONFIG_PACKAGE_luci-app-3cat is not set # 卫星插件，路由器无用
# CONFIG_PACKAGE_luci-app-smartdns is not set

### 集客 AC 控制器（需配合集客 AP 7.6+ 固件，建议 8.x）###
CONFIG_PACKAGE_gecoosac=y # 集客软 AC 后端守护进程（必须，否则管理页无法启动）
CONFIG_PACKAGE_luci-app-gecoosac=y # 集客 AC LuCI 网页界面（JS 增强版，适配 25.12 / LuCI 24.x）
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y # 集客 AC 中文语言包
CONFIG_PACKAGE_coreutils-nohup=y # nohup 依赖（gecoosac 后台运行必需）

# ---------- iStore ----------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y
# ---------- Harbor File ----------
CONFIG_PACKAGE_luci-app-harbor-file=y
CONFIG_PACKAGE_luci-i18n-harbor-file-zh-cn=y
# ---------- Athena LED ----------
CONFIG_PACKAGE_athena-led=y
CONFIG_PACKAGE_luci-app-athena-led=y

### 无线固件（雅典娜 QCN9074 / IPQ6010）###
CONFIG_PACKAGE_ath11k-firmware-ipq6010=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
